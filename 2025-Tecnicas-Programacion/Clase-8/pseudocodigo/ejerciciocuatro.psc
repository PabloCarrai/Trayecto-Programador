Algoritmo ejerciciocuatro
	Para i<-1 Hasta 30 Con Paso 1 Hacer
		Escribir "Ingrese un producto"
		leer producto
		Escribir "Ingrese su codigo"
		leer codigo
		Escribir "Ingrese su precio"
		leer precio
		Escribir "Ingrese su stock"
		leer stock
		Si precio>4999 Entonces
			Escribir "El producto ",producto
			Escribir "tiene un stock de ",stock			
		SiNo
			Escribir "El producto",producto
			Escribir "Codigo de producto ",codigo
		Fin Si
	Fin Para
	
FinAlgoritmo
