Algoritmo ejerciciocalculadora
	Escribir "Ingrese un numero"
	leer numero
	Escribir "Ingrese otro numero"
	leer numero1
	Escribir "La suma de ambos numeros es ",numero+numero1
	Escribir "La resta de ambos numeros es ",numero-numero1
	Escribir "La multiplicacion de ambos numeros es ",numero*numero1
	Si numero1=0 Entonces
		Escribir "No se puede dividir por 0"
	Sino
		Escribir "La division de ambos numeros es ",numero/numero1
	FinSi
	
FinAlgoritmo
