Algoritmo Ejercicioseis
	//Pseudocodigo que permita ingresar letras mientra sean distintas a la "A"
	// mostrar cantidad de letras ingresadas
	Escribir "Ingrese una letra"
	leer letra
	cletras<-0
	Mientras letra<>"A"
		Escribir "Ingrese otra letra"
		cletras<-cletras+1
		leer letra
	FinMientras
	Escribir "Cantidad de letras ingresadas"
	Escribir cletras
FinAlgoritmo
