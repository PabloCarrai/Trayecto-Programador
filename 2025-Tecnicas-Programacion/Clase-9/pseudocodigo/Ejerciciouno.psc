Algoritmo Ejerciciouno
	Para i<-1 Hasta 10 Con Paso 1 Hacer
		Escribir "Ingrese una letra"
		leer letra
		si ((letra="a" O letra="A") O (letra="e" O letra="E") O (letra="i" O letra="I") O (letra="o" O letra="O") o (letra="u" O letra="U")) Entonces
			Escribir "La letra es ",letra, " es una vocal"
		SiNo
			Escribir "No es una vocal ",letra
		FinSi
	Fin Para
	
FinAlgoritmo
