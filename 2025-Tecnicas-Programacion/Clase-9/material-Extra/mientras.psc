Algoritmo sin_titulo
	Edad = 18
	C<-0
	//Promedio de edad
	AcuEdad<-0
	Mientras Edad>=18
		Escribir "Sr. Usuario Ingrese una edad:"
		Leer Edad
		Escribir "Es mayor de edad"
		C<-C+1
		AcuEdad<-AcuEdad+Edad
	FinMientras
	Escribir "La cantidad de edades ingresadas es:"
	Escribir C
	Escribir "El promedio de edad es:"
	Escribir AcuEdad/C
FinAlgoritmo
