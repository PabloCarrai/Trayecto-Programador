Algoritmo sin_titulo
	Escribir "Se ingresan 100 numeros, Mostrar los impares"
	Para I<-1 Hasta 10 Con Paso 1 Hacer
		Escribir "Sr. Op. Ingrese un número:"
		Leer A
		Si A%2==1 Entonces
			Escribir "El número:",A," Es impar"
		SiNo
			Escribir "El número: Es Impar"
		FinSi
	FinPara
FinAlgoritmo
