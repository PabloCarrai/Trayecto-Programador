Algoritmo condicionales
	Escribir "Ingresa un numero"
	Leer Numero1
	Escribir "Ingresa otro numero"
	Leer Numero2
	Escribir "Vamos a averiguarl cual de los dos es mas grande"
	Si Numero1>Numero2 Entonces
		Escribir "El mas grande es ",Numero1
	SiNo
		Escribir "El mas grande es ",Numero2
	FinSi		
	Escribir "Ingresar nuevamente un numero"
