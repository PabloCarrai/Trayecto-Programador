Algoritmo Ejerciciciodos
	// Realizar un pseudocodigo que permita ingresar 20 personas y mostrar su
	//dni y el genero
	nombres=""
	Para i<-1 hasta 20
		Escribir "Vamos a ingresar los datos de 20 personas"
		Escribir "Ingrese su nombre "
		leer nombre
		Escribir "Ingrese su dni "
		leer dni
		Escribir "Ingrese su sexo "
		leer sexo
		nombres=nombres+nombre+" - "+dni+" - "+sexo		
	FinPara
	mostrar nombres
	
FinAlgoritmo
